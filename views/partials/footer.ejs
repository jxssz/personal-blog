<footer class="site">
  <div class="foot-mark" aria-hidden="true">MY&nbsp;BLOG</div>
  <div class="foot-line">© <%= new Date().getFullYear() %> 我的博客 · 由个人博客系统驱动</div>
</footer>
<script>
(function () {
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- 滚动显现 ---------- */
  var els = document.querySelectorAll('.reveal');
  if (!('IntersectionObserver' in window) || reduced) {
    els.forEach(function (el) { el.classList.add('in'); });
  } else {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.08 });
    els.forEach(function (el) { io.observe(el); });
  }

  /* ---------- 交互星图：粒子 + 连线 + 鼠标斥力 ---------- */
  var cv = document.getElementById('fx');
  var ctx = cv.getContext('2d');
  var W, H, pts = [], mouse = { x: -9999, y: -9999 };
  var COLORS = ['76,201,240', '247,37,133', '131,56,236'];

  function resize() {
    W = cv.width = window.innerWidth;
    H = cv.height = window.innerHeight;
    var n = Math.min(110, Math.floor(W / 12));
    pts = [];
    for (var i = 0; i < n; i++) {
      pts.push({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - .5) * .35,
        vy: (Math.random() - .5) * .35,
        r: Math.random() * 1.6 + .6,
        c: COLORS[i % COLORS.length]
      });
    }
  }
  resize();
  window.addEventListener('resize', function () {
    resize();
    if (reduced) return;
    /* 重排后补画一帧静态星点，避免黑屏 */
    pts.forEach(function (p) {
      p.vx = (Math.random() - .5) * .3;
      p.vy = (Math.random() - .5) * .3;
    });
    wake();
  });

  if (!reduced) {
    window.addEventListener('mousemove', function (e) { mouse.x = e.clientX; mouse.y = e.clientY; wake(); });
    window.addEventListener('mouseout', function () { mouse.x = -9999; mouse.y = -9999; });

    var raf = null;
    function wake() { if (!raf) raf = requestAnimationFrame(frame); }

    function frame() {
      var energy = mouse.x > -999 || pts.some(function (p) {
        return Math.abs(p.vx) > .04 || Math.abs(p.vy) > .04;
      });
      if (!energy) { raf = null; return; }   /* 全场静止：彻底停机 */
      ctx.clearRect(0, 0, W, H);
      for (var i = 0; i < pts.length; i++) {
        var p = pts[i];
        /* 鼠标斥力 */
        var dx = p.x - mouse.x, dy = p.y - mouse.y;
        var d2 = dx * dx + dy * dy;
        if (d2 < 16900 && d2 > 0.01) {          /* 130px 内被推开 */
          var f = (16900 - d2) / 16900 * .6;
          var d = Math.sqrt(d2);
          p.vx += dx / d * f * .25;
          p.vy += dy / d * f * .25;
        }
        p.vx *= .985; p.vy *= .985;             /* 阻尼：静止后停机省电 */
        p.x += p.vx; p.y += p.vy;
        if (p.x < -20) p.x = W + 20; if (p.x > W + 20) p.x = -20;
        if (p.y < -20) p.y = H + 20; if (p.y > H + 20) p.y = -20;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, 6.2832);
        ctx.fillStyle = 'rgba(' + p.c + ',.7)';
        ctx.fill();
      }
      /* 近距连线 */
      for (var a = 0; a < pts.length; a++) {
        for (var b = a + 1; b < pts.length; b++) {
          var q = pts[a], r = pts[b];
          var lx = q.x - r.x, ly = q.y - r.y;
          var ld = lx * lx + ly * ly;
          if (ld < 12100) {
            ctx.beginPath();
            ctx.moveTo(q.x, q.y);
            ctx.lineTo(r.x, r.y);
            ctx.strokeStyle = 'rgba(120,160,255,' + ((1 - ld / 12100) * .14).toFixed(3) + ')';
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
      }
      if (energy) raf = requestAnimationFrame(frame); else raf = null;
    }
    wake();
  } else {
    /* 降级：静默星点 */
    ctx.clearRect(0, 0, W, H);
    pts.forEach(function (p) {
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, 6.2832);
      ctx.fillStyle = 'rgba(' + p.c + ',.4)';
      ctx.fill();
    });
  }

  /* ---------- 光标追光 ---------- */
  var glow = document.querySelector('.cursor-glow');
  if (glow) {
    window.addEventListener('mousemove', function (e) {
      glow.style.opacity = 1;
      glow.style.transform = 'translate(' + e.clientX + 'px,' + e.clientY + 'px)';
    });
    window.addEventListener('mouseout', function () { glow.style.opacity = 0; });
  }

  /* ---------- 卡片 3D 倾斜 ---------- */
  if (!reduced && window.matchMedia('(hover: hover)').matches) {
    document.querySelectorAll('.post-list li').forEach(function (card) {
      card.addEventListener('mousemove', function (e) {
        var rect = card.getBoundingClientRect();
        var rx = ((e.clientY - rect.top) / rect.height - .5) * -7;
        var ry = ((e.clientX - rect.left) / rect.width - .5) * 9;
        card.style.transform = 'perspective(900px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg) translateY(-2px)';
      });
      card.addEventListener('mouseleave', function () { card.style.transform = ''; });
    });
  }
})();
</script>
</body>
</html>
