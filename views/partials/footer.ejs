</main>
<footer>
  <p>&copy; <%= new Date().getFullYear() %> <a href="/">我的博客</a></p>
</footer>

<script>
/* 按页面按需加载动效脚本；失败时静默降级，页面仍可正常阅读。 */
(function () {
  var path = location.pathname;
  var isHome = path === '/' || path === '/posts' || path.indexOf('/tag/') === 0;
  var isPost = path.indexOf('/post/') === 0;
  var isAbout = path === '/about';
  var isTags = path === '/tags';

  function load(src, before) {
    var s = document.createElement('script');
    s.src = src;
    s.async = false;
    if (before) before.parentNode.insertBefore(s, before);
    else document.head.appendChild(s);
    return s;
  }

  function loadCss(href) {
    var l = document.createElement('link');
    l.rel = 'stylesheet';
    l.href = href;
    document.head.appendChild(l);
  }

  var anchor = document.currentScript;

  // 基础：Lenis + GSAP + ScrollTrigger + SplitText + anime.js（轻量）
  load('/vendor/gsap.min.js', anchor);
  load('/vendor/ScrollTrigger.min.js', anchor);
  load('/vendor/SplitText.min.js', anchor);
  load('/vendor/lenis.min.js', anchor);
  load('/vendor/anime.min.js', anchor);
  load('/js/motion.js', anchor);
  load('/js/lottie.js', anchor);

  if (isHome) {
    load('/js/hero.js', anchor);
  }

  if (isPost) {
    loadCss('/vendor/photoswipe.css');
    loadCss('/vendor/swiper-bundle.min.css');
    loadCss('/vendor/plyr.css');
    load('/vendor/photoswipe.umd.min.js', anchor);
    load('/vendor/photoswipe-lightbox.umd.min.js', anchor);
    load('/vendor/swiper-bundle.min.js', anchor);
    load('/vendor/plyr.min.js', anchor);
    load('/js/gallery.js', anchor);
    load('/js/player.js', anchor);
    load('/js/scroll.js', anchor);
  }

  if (isAbout) {
    load('/js/about.js', anchor);
  }

  if (isTags) {
    load('/js/tags.js', anchor);
  }
})();
</script>
</body>
</html>