<%- include('../partials/header', { title: '文章管理' }) %>
<%- include('nav') %>

<article>
  <h1>文章管理</h1>
  <table class="admin-table">
    <tr><th>标题</th><th>标签</th><th>状态</th><th>日期</th><th>操作</th></tr>
    <% posts.forEach(function (p) { %>
      <tr>
        <td><a href="/post/<%= p.id %>"><%= p.title %></a></td>
        <td><%= p.tags || '—' %></td>
        <td><span class="badge <%= p.published ? 'yes' : 'no' %>"><%= p.published ? '已发布' : '草稿' %></span></td>
        <td><%= formatDate(p.created_at) %></td>
        <td>
          <a href="/admin/post/<%= p.id %>/edit">编辑</a> ·
          <form method="post" action="/admin/post/<%= p.id %>/delete" style="display:inline" onsubmit="return confirm('确定删除这篇文章及其留言？')">
            <button type="submit" class="ghost" style="border:none;color:#c66;padding:0;background:none">删除</button>
          </form>
        </td>
      </tr>
    <% }); %>
    <% if (!posts.length) { %><tr><td colspan="5">还没有文章，点"写新文章"开始。</td></tr><% } %>
  </table>
</article>

<%- include('../partials/footer') %>
