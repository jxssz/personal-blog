<%- include('../partials/header', { title: post ? '编辑文章' : '写新文章' }) %>
<%- include('nav') %>

<article>
  <h1><%= post ? '编辑文章' : '写新文章' %></h1>
  <form class="admin-form" method="post" action="<%= post ? '/admin/post/' + post.id + '/edit' : '/admin/post/new' %>">
    <label>标题</label>
    <input type="text" name="title" value="<%= post ? post.title : '' %>" required>
    <label>摘要（列表页展示，可留空）</label>
    <input type="text" name="summary" value="<%= post ? post.summary : '' %>">
    <label>标签（用逗号分隔，最多 10 个，如：技术, 生活）</label>
    <input type="text" name="tags" value="<%= post ? post.tags : '' %>">
    <label>正文（支持 Markdown，可插入图片和视频）</label>
    <div class="upload-bar">
      <input type="file" id="upload-image" accept="image/*" hidden>
      <input type="file" id="upload-video" accept="video/*" hidden>
      <button type="button" class="ghost" onclick="document.getElementById('upload-image').click()">上传图片</button>
      <button type="button" class="ghost" onclick="document.getElementById('upload-video').click()">上传视频</button>
      <span class="tip" id="upload-status"></span>
    </div>
    <textarea name="content" id="content-box"><%= post ? post.content : '' %></textarea>
    <label>
      <input type="checkbox" name="published" value="1" style="width:auto" <%= post && post.published ? 'checked' : '' %>>
      发布（不勾选则保存为草稿）
    </label>
    <p>
      <button type="submit">保存</button>
      <a href="/admin" style="margin-left:12px">返回</a>
    </p>
  </form>
</article>

<script>
(function () {
  var box = document.getElementById('content-box');
  var status = document.getElementById('upload-status');

  function insertAtCursor(text) {
    var start = box.selectionStart, end = box.selectionEnd;
    var before = box.value.slice(0, start), after = box.value.slice(end);
    box.value = before + text + after;
    box.selectionStart = box.selectionEnd = start + text.length;
    box.focus();
  }

  function upload(input, isVideo) {
    var file = input.files && input.files[0];
    if (!file) return;
    status.textContent = '正在上传 ' + file.name + ' …';
    var fd = new FormData();
    fd.append('file', file);
    fetch('/admin/upload', { method: 'POST', body: fd })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) { status.textContent = data.error; return; }
        insertAtCursor(isVideo ? '\n[视频](' + data.url + ')\n' : '![' + file.name + '](' + data.url + ')\n');
        status.textContent = '已插入：' + data.url;
      })
      .catch(function () { status.textContent = '上传失败，请重试'; });
    input.value = '';
  }

  document.getElementById('upload-image').addEventListener('change', function () { upload(this, false); });
  document.getElementById('upload-video').addEventListener('change', function () { upload(this, true); });
})();
</script>

<%- include('../partials/footer') %>
